{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Apocalipse Download Manager",
  "version": "0.4.0",
  "identifier": "com.linuxhell.apocalipse",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "Apocalipse Download Manager",
      "width": 1180,
      "height": 760,
      "minWidth": 900,
      "minHeight": 600,
      "center": true,
      "decorations": true,
      "transparent": false
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: https:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
