{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Apocalipse Download Manager",
  "version": "0.5.7",
  "identifier": "com.linuxhell.apocalipse",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Apocalipse Download Manager",
        "width": 980,
        "height": 620,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: https:; media-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
