{
  "manifest_version": 3,
  "key": "",
  "name": "__MSG_extensionName__",
  "version": "0.3.203",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "permissions": [
    "activeTab",
    "storage",
    "downloads",
    "alarms",
    "clipboardRead",
    "cookies",
    "webRequest",
    "declarativeNetRequest",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://tiktok.com/*",
        "https://*.tiktok.com/*"
      ],
      "js": [
        "tiktok-main-identity.js",
        "tiktok-page-identity.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://rapidgator.net/*",
        "https://*.rapidgator.net/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "https://tiktok.com/*",
        "https://*.tiktok.com/*"
      ],
      "js": [
        "diagnostics-core.js",
        "diagnostics.js",
        "diagnostics-media-replay.js",
        "tiktok-identity.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://tiktok.com/*",
        "https://*.tiktok.com/*"
      ],
      "js": [
        "diagnostics-core.js",
        "diagnostics.js",
        "diagnostics-media-replay.js",
        "tiktok-identity.js",
        "tiktok-media-fix.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://instagram.com/*",
        "https://*.instagram.com/*"
      ],
      "js": [
        "instagram-media-fix.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://uupdump.net/*",
        "https://*.uupdump.net/*"
      ],
      "js": [
        "uupdump-post-fix.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://facebook.com/*",
        "https://*.facebook.com/*",
        "https://tiktok.com/*",
        "https://*.tiktok.com/*"
      ],
      "js": [
        "social-player-resolution.js",
        "social-player-resolution-v2.js",
        "social-home-feed-v3-core.js",
        "social-home-feed-v3-facebook.js",
        "facebook-menu-v4.js",
        "social-home-feed-v3-tiktok.js",
        "tiktok-share-menu-v4.js",
        "social-home-feed-resolution-v3.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/apocalipse-a-16.png",
    "32": "icons/apocalipse-a-32.png",
    "48": "icons/apocalipse-a-48.png",
    "128": "icons/apocalipse-a-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Apocalipse",
    "default_icon": {
      "16": "icons/apocalipse-a-16.png",
      "32": "icons/apocalipse-a-32.png",
      "48": "icons/apocalipse-a-48.png"
    }
  },
  "version_name": "0.3.203"
}
